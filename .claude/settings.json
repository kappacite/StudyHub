{
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(pytest*)",
      "Bash(python -m pytest*)",
      "Bash(python -m ruff*)",
      "Bash(ruff*)",
      "Bash(npm run test*)",
      "Bash(npm run lint*)",
      "Bash(npm run build*)",
      "Bash(npx vitest*)",
      "Bash(npx vue-tsc*)",
      "Bash(npx eslint*)",
      "Bash(npx prettier*)",
      "Bash(docker compose exec*)",
      "Bash(docker compose logs*)",
      "Bash(docker compose ps*)",
      "PowerShell(git status*)",
      "PowerShell(git diff*)",
      "PowerShell(git log*)",
      "PowerShell(git add*)",
      "PowerShell(git commit*)",
      "PowerShell(git show*)",
      "PowerShell(git branch*)",
      "PowerShell(pytest*)",
      "PowerShell(python -m pytest*)",
      "PowerShell(python -m ruff*)",
      "PowerShell(ruff*)",
      "PowerShell(npm run test*)",
      "PowerShell(npm run lint*)",
      "PowerShell(npm run build*)",
      "PowerShell(npx vitest*)",
      "PowerShell(npx vue-tsc*)",
      "PowerShell(npx eslint*)",
      "PowerShell(npx prettier*)",
      "PowerShell(docker compose exec*)",
      "PowerShell(docker compose logs*)",
      "PowerShell(docker compose ps*)"
    ],
    "deny": [
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git reset --hard)",
      "Bash(git reset --hard *)",
      "Bash(git rebase)",
      "Bash(git rebase *)",
      "Bash(rm -rf *)",
      "Bash(rm -r -f *)",
      "Bash(docker compose down -v)",
      "Bash(docker compose down -v *)",
      "Bash(docker compose down --volumes)",
      "Bash(docker compose down --volumes *)",
      "Bash(./deploy.sh)",
      "Bash(./deploy.sh *)",
      "Bash(bash deploy.sh)",
      "Bash(bash deploy.sh *)",
      "Bash(flask db upgrade)",
      "Bash(flask db upgrade *)",
      "PowerShell(git push)",
      "PowerShell(git push *)",
      "PowerShell(git reset --hard)",
      "PowerShell(git reset --hard *)",
      "PowerShell(git rebase)",
      "PowerShell(git rebase *)",
      "PowerShell(rm -rf *)",
      "PowerShell(Remove-Item -Recurse -Force *)",
      "PowerShell(docker compose down -v)",
      "PowerShell(docker compose down -v *)",
      "PowerShell(docker compose down --volumes)",
      "PowerShell(docker compose down --volumes *)",
      "PowerShell(./deploy.sh)",
      "PowerShell(./deploy.sh *)",
      "PowerShell(flask db upgrade)",
      "PowerShell(flask db upgrade *)",
      "Edit(.env)",
      "Edit(**/.env)",
      "Write(.env)",
      "Write(**/.env)"
    ],
    "ask": [
      "Bash(pip install*)",
      "Bash(pip3 install*)",
      "Bash(python -m pip install*)",
      "Bash(npm install*)",
      "Bash(npm ci*)",
      "Bash(flask db migrate*)",
      "PowerShell(pip install*)",
      "PowerShell(pip3 install*)",
      "PowerShell(python -m pip install*)",
      "PowerShell(npm install*)",
      "PowerShell(npm ci*)",
      "PowerShell(flask db migrate*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_dangerous_commands.py\""
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/phase_guard.py\""
          },
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/tdd_guard.py\""
          },
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/workflow_guard.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/no_debug.py\""
          },
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/raw_value_guard.py\""
          },
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/no_secrets.py\""
          },
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/format_backend.py\""
          },
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/format_web.py\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop_gate.py\""
          },
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/workflow_stop_gate.py\""
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "auto",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/contexte_precompact.py\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/session_start_resume.py\""
          }
        ]
      },
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/session_start.py\""
          }
        ]
      }
    ]
  },
  "env": {
    "CLAUDE_FENETRE_CONTEXTE": "200000",
    "CLAUDE_SEUIL_PASSATION": "0.90"
  }
}
