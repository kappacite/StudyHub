+import { ChevronLeft, Sparkles, BookOpen, RotateCcw } from '@lucide/vue'
+
+const route = useRoute()
+const router = useRouter()
+
+const noteId = ref(route.params.id as string)
+const noteTitle = ref('')
+
+const step = ref<'writing' | 'results'>('writing')
+const explanation = ref('')
+const analyzing = ref(false)
+
+const result = ref<{
+  clarity_score: number
+  jargon: string[]
+  gaps: Array<{ concept: string; issue: string }>
+  feedback: string
+  suggestion: string
+}>({ clarity_score: 0, jargon: [], gaps: [], feedback: '', suggestion: '' })
+
+const scoreColorClass = computed(() => {
+  const score = result.value.clarity_score
+  if (score >= 80) return 'text-emerald-500'
+  if (score >= 50) return 'text-amber-500'
+  return 'text-rose-500'
+})
+
+async function loadNote() {
+  try {
+    const res = await api.get(`/notes/${noteId.value}`)
+    noteTitle.value = res.data.title
+  } catch (err) {
+    console.error('Erreur lors du chargement de la note', err)
+    alert('Impossible de charger la note.')
+    goBack()
+  }
+}
+
+onMounted(loadNote)
+
+function goBack() {
+  router.push(`/notes/${noteId.value}`)
+}
+
+function resetSession() {
+  explanation.value = ''
+  result.value = { clarity_score: 0, jargon: [], gaps: [], feedback: '', suggestion: '' }
+  step.value = 'writing'
+}
+
+async function submitForAnalysis() {
+  if (!explanation.value.trim()) return
+  analyzing.value = true
+
+  try {
+    const response = await api.post('/feynman/analyze', {
+      note_id: noteId.value,
+      user_explanation: explanation.value,
+      duration_seconds: 0,
+    })
+
+    if (response.data.status === 'SUCCESS' && response.data.result) {
+      result.value = response.data.result
+      step.value = 'results'
+      return
+    }
+
+    const { task_id } = response.data
+    if (!task_id) {
+      throw new Error("L'API n'a pas retourné de identifiant de tâche (task_id).")
+    }
+
+    let finished = false
+    let attempts = 0
+    const maxAttempts = 60
+
+    while (!finished && attempts < maxAttempts) {
+      attempts++
+      await new Promise((resolve) => setTimeout(resolve, 2000))
+
+      const pollResponse = await api.get(`/feynman/tasks/${task_id}`)
+      const status = pollResponse.data.status
+
+      if (status === 'SUCCESS') {
+        finished = true
+        result.value = pollResponse.data.result
+        step.value = 'results'
+      } else if (status === 'FAILURE' || pollResponse.data.error) {
+        finished = true
+        const errorMsg = pollResponse.data.error?.message || "L'analyse a échoué."
+        throw new Error(errorMsg)
+      }
+    }
+
+    if (!finished) {
+      throw new Error("L'analyse a mis trop de temps à s'exécuter. Veuillez réessayer.")
+    }
+  } catch (err: any) {
+    console.error("Erreur lors de l'analyse par l'IA", err)
+    const errMsg = err.response?.data?.error?.message || err.message || 'Une erreur inconnue est survenue.'
+    alert(`Erreur d'analyse IA : ${errMsg}`)
+  } finally {
+    analyzing.value = false
+  }
+}
+</script>
+
+<style scoped>
+.animate-fade-in {
