# Copier en .env et renseigner les valeurs reelles avant `docker compose up`.
# .env est ignore par git (voir .gitignore) — ne jamais y mettre de vraies valeurs
# dans ce fichier .example, seulement des placeholders.

# --- Base de donnees (service `db`) ---
POSTGRES_USER=studyhub
POSTGRES_PASSWORD=changeme
POSTGRES_DB=studyhub

# --- Backend Flask (services `backend`, `worker`) ---
FLASK_ENV=production
DATABASE_URL=postgresql://studyhub:changeme@db:5432/studyhub
REDIS_URL=redis://redis:6379/0
SECRET_KEY=changeme-64-caracteres-aleatoires
JWT_SECRET_KEY=changeme-64-caracteres-aleatoires
JWT_ACCESS_TOKEN_EXPIRES=900
JWT_REFRESH_TOKEN_EXPIRES=2592000
UPLOAD_FOLDER=/app/uploads
MAX_CONTENT_LENGTH=52428800
GEMINI_API_KEY=changeme
GEMINI_MODEL=gemini-2.0-flash

# --- Frontend (build-time, service `frontend`) ---
VITE_API_BASE_URL=http://localhost:5000

# --- CORS (optionnel, valeur par defaut dans backend/app/__init__.py si absent) ---
# CORS_ALLOWED_ORIGINS=https://study.leshen.cloud,http://localhost:5173,http://localhost:3000
